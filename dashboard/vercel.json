{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/auth/(.*)", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/docs(.*)", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "src": "/redoc(.*)", "dest": "/api/index.py" },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|svg|ico|woff|woff2|ttf|eot|map))", "dest": "/dist/$1" },
    { "src": "/(.*?)\\.html", "dest": "/dist/$1.html" },
    { "src": "/favicon.svg", "dest": "/dist/favicon.svg" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ]
}
